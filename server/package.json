{
  "name": "server",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "npm run swagger && node server.js",
    "dev": "nodemon --trace-deprecation --ignore src/docs/swagger-output.json --ignore src/utilities/swagger-temp-loader.util.js server.js",
    "---- DATABASE MANAGEMENT ----": "-------------------------",
    "db:status": "node src/database/utilities/check-migration.util.js",
    "db:setup": "node src/database/utilities/db-setup.util.js",
    "db:create": "npx sequelize-cli db:create",
    "db:drop": "node src/database/settings/confirmation.settings.js \"⚠️ WARNING: This will DROP the database. Type 'yes' to continue: \" && npx sequelize-cli db:drop",
    "db:reset": "node src/database/settings/confirmation.settings.js \"⚠️ WARNING: This will RESET the database. Type 'yes' to continue: \" && npm run db:drop && npm run db:setup",
    "sequelize:init": "sequelize init",
    "---- MIGRATIONS ----": "-------------------------",
    "db:migrate": "npx sequelize-cli db:migrate && npm run db:generate:models",
    "db:migrate:undo": "npx sequelize-cli db:migrate:undo && npm run db:generate:models",
    "db:migrate:prod": "npx sequelize-cli db:migrate --migrations-path src/database/migrations/alter && npm run db:generate:models",
    "db:migrate:undo:prod": "npx sequelize-cli db:migrate:undo --migrations-path src/database/migrations/alter && npm run db:generate:models",
    "db:seed": "npx sequelize-cli db:seed:all",
    "db:seed:undo": "npx sequelize-cli db:seed:undo:all",
    "db:generate:migration": "npx sequelize-cli migration:generate --migrations-path src/database/migrations/create --name",
    "db:generate:seeder": "npx sequelize-cli seed:generate --seeders-path src/database/seeders --name",
    "---- CRYPTOGRAPHY ----": "-------------------------",
    "encrypt": "node src/utilities/cryptography.util.js encrypt",
    "decrypt": "node src/utilities/cryptography.util.js decrypt",
    "---- FEATURE GENERATION ----": "-------------------------",
    "make:feature": "node src/utilities/generate-feature.util.js",
    "db:generate:models": "node src/database/utilities/generate-models.util.js"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.0",
    "connect-mongo": "^5.1.0",
    "connect-mongodb-session": "^5.0.0",
    "convert-units": "^2.3.4",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "express-paginate": "^1.0.2",
    "express-rate-limit": "^8.0.0",
    "express-session": "^1.18.2",
    "express-winston": "^4.2.0",
    "http-errors": "~1.6.3",
    "joi": "^18.0.1",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "mongoose": "^7.8.7",
    "morgan": "^1.10.1",
    "mysql2": "^3.15.3",
    "node-cache": "^5.1.2",
    "node-linq": "^0.0.5",
    "nodemailer": "^8.0.7",
    "nodemon": "^3.1.10",
    "sequelize": "^6.37.7",
    "sequelize-pack": "^1.0.4",
    "socket.io": "^4.8.1",
    "swagger-autogen": "^2.23.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.0",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.18.3",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
